    <input type="text" id="button_okInput" name="button_ok" style="flex:1;" />
</div>

<div>
    <label for="button_nokInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_button_nok%>:</label>
    <input type="text" id="button_nokInput" name="button_nok" style="flex:1;" />
</div>

<div>
    <label for="sendInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_send%>:</label>
    <input type="text" id="sendInput" name="sendText" style="flex:1;" />
</div>

<div>
    <label for="send_disabledInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_send_disabled%>:</label>
    <input type="text" id="send_disabledInput" name="send_disabled" style="flex:1;" />
</div>

<div>
    <label for="retryInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_retry%>:</label>
    <input type="text" id="retryInput" name="retry" style="flex:1;" />
</div>

<div>
    <label for="congratsInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_congrats%>:</label>
    <input type="text" id="congratsInput" name="congrats" style="flex:1;" />
</div>

<div>
    <label for="modalheaderInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalheader%>:</label>
    <input type="text" id="modalheaderInput" name="modalheader" style="flex:1;" />
</div>

<div>
    <label for="modalcontentInput"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalcontent%>:</label>
    <textarea id="modalcontentInput" name="modalcontent" class="inverse" style="flex:1; min-height: 80px;"></textarea>
</div>

<div>
    <label for="modalinstructions0Input"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalinstructions0%>:</label>
    <input type="text" id="modalinstructions0Input" name="modalinstructions0" style="flex:1;" />
</div>

<div>
    <label for="modalinstructions1Input"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalinstructions1%>:</label>
    <input type="text" id="modalinstructions1Input" name="modalinstructions1" style="flex:1;" />
</div>

<div>
    <label for="modalinstructions2Input"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalinstructions2%>:</label>
    <input type="text" id="modalinstructions2Input" name="modalinstructions2" style="flex:1;" />
</div>

<div>
    <label for="modalheader2Input"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_modalheader2%>:</label>
    <input type="text" id="modalheader2Input" name="modalheader2" style="flex:1;" />
</div>

<h4 class="titleLabelEdit"><%=i18n.reusablePuzzleApps.DigitalClassifier.items%></h4>

<div style="margin: 15px 0px; display: block;">
    <input type="hidden" id="tabletItemsInput" name="items" />
    <datalist id="tabletItemAssetsList"></datalist>

    <div id="tabletItemsWrapper" style="flex-direction: column;">
        <% for (let i = 1; i <= 2; i++) { %>
            <div class="tabletItemWrapper" itemNumber="<%=i%>" style="display: flex; flex-direction: column; border: 1px solid white; padding: 10px 15px; border-radius: 20px; margin: 10px 0px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <p style="margin: 5px 0px;"><%=i18n.reusablePuzzleApps.DigitalClassifier.item%> <%=i%></p>
                    <button class="deleteTabletItem" type="button" style="display:none; border: none; background: none; cursor: pointer; font-size: 22px;" onclick="deleteTabletItem(event)">
                        <span style="color: rgb(185, 62, 68);" class="material-icons">delete_outline</span>
                    </button>
                </div>
                <input type="hidden" class="inputItemIframe" value="true" />
                <div style="display: flex; align-items: center; margin: 8px 0px;">
                    <label style="min-width: 80px;"><%=i18n.reusablePuzzleApps.DigitalClassifier.item%>:</label>
                    <div style="display: flex; align-items: center; flex: 1;">
                        <input class="inputItemPath" type="text" list="tabletItemAssetsList" placeholder="<%=i18n.reusablePuzzleApps.Common.BackgroundURLPlaceholder%>" style="flex:1;" />
                        <button type="button" class="clearItemPath" style="display: none; border: none; background: none; cursor: pointer; padding: 0 5px; font-size: 18px; color: rgb(185, 62, 68);">
                            <span class="material-icons">close</span>
                        </button>
                    </div>
                </div>
                <div style="display: none; align-items: center; margin: 8px 0px;">
                    <label style="min-width: 80px;"><%=i18n.reusablePuzzleApps.DigitalClassifier.label_feedback%>:</label>
                    <input class="inputItemFeedback" type="text" style="flex:1;" />
                </div>
            </div>
        <% } %>

        <button class="rounded small addTabletItem" type="button" onclick="addTabletItem(event);" style="background-color: white;">
            <span class="material-icons" style="color: #161938">add</span> <%=i18n.reusablePuzzleApps.DigitalClassifier.addItem%>
        </button>
    </div>
</div>
<br>

<script>
    // Populate shared datalist for item assets
    var tabletAssetMap = {};
    var tabletAssetTypeMap = {};
    (function() {
        var datalistEl = document.getElementById('tabletItemAssetsList');
        var origin = window.location.origin;
        (window.assets || []).forEach(asset => {
            let url = asset.url || `/assets/${asset.id}`;
            if (url.startsWith('/')) { url = origin + url; }
            else if (!url.startsWith('http')) { url = origin + '/assets/' + url; }
            tabletAssetMap[asset.filename] = url;
            tabletAssetTypeMap[url] = asset.assetType || '';
            var option = document.createElement('option');
            option.value = asset.filename;
            option.setAttribute('data-url', url);
            datalistEl.appendChild(option);
        });
    })();

    // Determine if URL is an image (iframe = false for images, true otherwise)
    function isImageUrl(url) {
        if (!url) return false;
        // Check asset type map first
        var assetType = tabletAssetTypeMap[url];
        if (assetType && assetType.toLowerCase().includes('image')) return true;
        // Fallback to extension check
        var imageExtensions = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp', '.ico'];
        var lowerUrl = url.toLowerCase();
        return imageExtensions.some(function(ext) { return lowerUrl.endsWith(ext); });
    }

    // Update iframe value based on path
    function updateIframeValue(wrapper) {
        var pathInput = wrapper.querySelector('input.inputItemPath');
        var iframeInput = wrapper.querySelector('input.inputItemIframe');
        if (pathInput && iframeInput) {
            // iframe = false for images, true for everything else (HTML, etc.)
            iframeInput.value = isImageUrl(pathInput.value) ? 'false' : 'true';
        }
    }

    // Handle clear button visibility
    function updateTabletClearButtonVisibility(input) {
        var clearBtn = input.closest('div').querySelector('.clearItemPath');
        if (clearBtn) {
            clearBtn.style.display = input.value ? 'block' : 'none';
        }
    }

    // Action after solve toggle
    // document.getElementById('actionValue').addEventListener('change', function() {
    //     if (this.value === 'SHOW_MESSAGE') {
    //         document.getElementById("actionDiv").style.display = 'flex';
    //     } else {
    //         document.getElementById("actionDiv").style.display = 'none';
    //     }
    // });

    // Update items JSON
    function updateTabletItems() {
        var tabletItemsArr = [];
        document.querySelectorAll('#tabletItemsWrapper .tabletItemWrapper').forEach(function(wrapper) {
            var item = {};
            item.iframe = wrapper.querySelector('input.inputItemIframe').value === 'true';
            item.path = wrapper.querySelector('input.inputItemPath').value;
            item.feedback = wrapper.querySelector('input.inputItemFeedback').value;
            tabletItemsArr.push(item);
        });
        document.getElementById('tabletItemsInput').value = JSON.stringify(tabletItemsArr);
    }

    // Add new item
    function addTabletItemToWrapper(wrapper) {
        var $wrapper = $(wrapper);
        var $allItems = $wrapper.find('.tabletItemWrapper');
        var $firstItem = $allItems.first();
        if ($firstItem.length === 0) return;
        var itemNumber = $allItems.length + 1;
        if (itemNumber > 50) return;
        var $newItem = $firstItem.clone();
        $newItem.attr('itemNumber', itemNumber);
        $newItem.find('p').first().html('<%=i18n.reusablePuzzleApps.DigitalClassifier.item%> ' + itemNumber);
        $newItem.find('button.deleteTabletItem').first().show();
        $newItem.find('input.inputItemIframe').val('true');
        $newItem.find('input.inputItemPath').val('');
        $newItem.find('input.inputItemFeedback').val('');
        $newItem.find('.clearItemPath').hide();
        $wrapper.find('button.addTabletItem').before($newItem);
        if (itemNumber === 50) {
            var $addButton = $wrapper.find('button.addTabletItem');
            $addButton.attr('disabled', 'disabled');
            $addButton.css('background-color', '#999');
        }
        updateTabletItems();
    }

    function addTabletItem(e) {
        e.stopPropagation();
        e.preventDefault();
        var wrapper = document.getElementById('tabletItemsWrapper');
        addTabletItemToWrapper(wrapper);
    }

    // Delete item
    function deleteTabletItem(e) {
        e.stopPropagation();
        e.preventDefault();
        var $itemWrapper = $(e.target).closest('.tabletItemWrapper');
        if ($itemWrapper.length !== 1) return;
        var $itemsWrapper = $itemWrapper.parent('#tabletItemsWrapper');
        if ($itemsWrapper.length !== 1) return;
        $itemWrapper.remove();
        $itemsWrapper.find('.tabletItemWrapper').each(function(index) {
            $(this).attr('itemNumber', index + 1);
            $(this).find('p').first().text('<%=i18n.reusablePuzzleApps.DigitalClassifier.item%> ' + (index + 1));
        });
        var $addButton = $itemsWrapper.find('button.addTabletItem');
        $addButton.removeAttr('disabled');
        $addButton.css('background-color', 'white');
        updateTabletItems();
    }

    // Event listeners for item inputs
    $('#tabletItemsWrapper').on('change', 'input.inputItemFeedback', updateTabletItems);

    // Convert filename to URL when selecting from datalist, update iframe and clear button
    $('#tabletItemsWrapper').on('change', 'input.inputItemPath', function() {
        if (tabletAssetMap[this.value]) {
            this.value = tabletAssetMap[this.value];
        }
        var wrapper = $(this).closest('.tabletItemWrapper')[0];
        updateIframeValue(wrapper);
        updateTabletClearButtonVisibility(this);
        updateTabletItems();
    });

    // Update clear button on input
    $('#tabletItemsWrapper').on('input', 'input.inputItemPath', function() {
        updateTabletClearButtonVisibility(this);
    });

    // Clear button click handler
    $('#tabletItemsWrapper').on('click', '.clearItemPath', function(e) {
        e.preventDefault();
        var input = $(this).closest('div').find('.inputItemPath');
        input.val('');
        $(this).hide();
        updateTabletItems();
    });

    // Initialize clear buttons for existing inputs
    document.querySelectorAll('.inputItemPath').forEach(function(input) {
        updateTabletClearButtonVisibility(input);
    });

    // Load config values
    // Load text labels (only if config exists, otherwise use defaults from HTML)
    if (window.currentOpenPuzzleConfig?.button_ok) document.getElementById("button_okInput").value = window.currentOpenPuzzleConfig.button_ok;
    if (window.currentOpenPuzzleConfig?.button_nok) document.getElementById("button_nokInput").value = window.currentOpenPuzzleConfig.button_nok;
    if (window.currentOpenPuzzleConfig?.sendText) document.getElementById("sendInput").value = window.currentOpenPuzzleConfig.sendText;
    if (window.currentOpenPuzzleConfig?.send_disabled) document.getElementById("send_disabledInput").value = window.currentOpenPuzzleConfig.send_disabled;
    if (window.currentOpenPuzzleConfig?.retry) document.getElementById("retryInput").value = window.currentOpenPuzzleConfig.retry;
    if (window.currentOpenPuzzleConfig?.congrats) document.getElementById("congratsInput").value = window.currentOpenPuzzleConfig.congrats;
    if (window.currentOpenPuzzleConfig?.modalheader) document.getElementById("modalheaderInput").value = window.currentOpenPuzzleConfig.modalheader;
    if (window.currentOpenPuzzleConfig?.modalcontent) document.getElementById("modalcontentInput").value = window.currentOpenPuzzleConfig.modalcontent;
    if (window.currentOpenPuzzleConfig?.modalinstructions0) document.getElementById("modalinstructions0Input").value = window.currentOpenPuzzleConfig.modalinstructions0;
    if (window.currentOpenPuzzleConfig?.modalinstructions1) document.getElementById("modalinstructions1Input").value = window.currentOpenPuzzleConfig.modalinstructions1;
    if (window.currentOpenPuzzleConfig?.modalinstructions2) document.getElementById("modalinstructions2Input").value = window.currentOpenPuzzleConfig.modalinstructions2;
    if (window.currentOpenPuzzleConfig?.modalheader2) document.getElementById("modalheader2Input").value = window.currentOpenPuzzleConfig.modalheader2;

    // Load existing items
    if (window.currentOpenPuzzleConfig?.items) {
        var tabletItems = window.currentOpenPuzzleConfig.items;
        if (typeof tabletItems === 'string') {
            try { tabletItems = JSON.parse(tabletItems); } catch(e) { tabletItems = []; }
        }
        if (Array.isArray(tabletItems)) {
            var $itemsWrapper = $('#tabletItemsWrapper');
            for (var i = 0; i < Math.min(tabletItems.length, 50); i++) {
                var itemNumber = i + 1;
                if (itemNumber > 2) {
                    addTabletItemToWrapper($itemsWrapper[0]);
                }
                var $itemDiv = $itemsWrapper.find(".tabletItemWrapper[itemNumber='" + itemNumber + "']");
                $itemDiv.find('input.inputItemIframe').val(tabletItems[i].iframe ? 'true' : 'false');
                var pathInput = $itemDiv.find('input.inputItemPath');
                pathInput.val(tabletItems[i].path || '');
                updateTabletClearButtonVisibility(pathInput[0]);
                $itemDiv.find('input.inputItemFeedback').val(tabletItems[i].feedback || '');
            }
        }
    }
    // Always update to save current state
    updateTabletItems();

    // Toggle action div visibility
    // if (window.currentOpenPuzzleConfig?.actionAfterSolve === 'SHOW_MESSAGE') {
    //     document.getElementById("actionDiv").style.display = 'block';
    // } else {
    //     document.getElementById("actionDiv").style.display = 'none';
    // }
</script>
