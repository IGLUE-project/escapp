<%- include ('../partials/_header.ejs') %>

<div class='main' style='color:white;padding:20px'>
    <h1><%=i18n.reusablePuzzles.edit%>: <%=name%></h1>

    <div class="rp-edit-layout">
        <div class="rp-edit-current">
            <% if (thumbnail) { %>
                <img src="/reusablePuzzles/<%=id%>/<%=thumbnail%>" alt="<%=name%>" class="rp-edit-thumb"/>
            <% } else { %>
                <div class="rp-edit-thumb rp-edit-thumb-empty"><span class="material-icons" style="font-size:3em;">extension</span></div>
            <% } %>
            <ul class="rp-edit-info">
                <li><strong><%=i18n.reusablePuzzles.order%>:</strong> <%=order%></li>
                <li><strong><%=i18n.reusablePuzzles.status%>:</strong> <%= disabled ? i18n.reusablePuzzles.disabled : i18n.reusablePuzzles.enabledLabel %></li>
                <li><strong><%=i18n.reusablePuzzles.formTemplate%>:</strong> <code><%= form || url %></code></li>
                <li><strong><%=i18n.reusablePuzzles.currentThumbnail%>:</strong> <%= thumbnail || "—" %></li>
                <li><strong><%=i18n.reusablePuzzles.instructions%>:</strong> <%= instructions || "—" %></li>
            </ul>
        </div>

        <form method='POST' enctype='multipart/form-data' action='/reusablePuzzles/<%=id%>?_method=PUT' class="rp-edit-form">
            <p class="rp-edit-hint"><%=i18n.reusablePuzzles.editHint%></p>

            <label><%=i18n.reusablePuzzles.puzzleName%>
                <input type='text' value='<%=name%>' name='name' required/>
            </label>

            <label><%=i18n.reusablePuzzles.order%>
                <input type='number' value='<%=order%>' name='order' min='1' max='99999'/>
            </label>

            <label><%=i18n.reusablePuzzles.formTemplate%>
                <input type='text' value='' name='form' placeholder='<%= form || i18n.reusablePuzzles.keepCurrent %>'/>
            </label>

            <label><%=i18n.reusablePuzzles.replaceZip%>
                <input type='file' name='file' accept='.zip'/>
            </label>

            <label><%=i18n.reusablePuzzles.replaceThumbnail%>
                <input type='file' name='thumbnail' accept='image/*'/>
            </label>

            <input type='submit' value='<%=i18n.common.save%>'/>
        </form>
    </div>

    <button onclick='window.location.replace(document.referrer || "/reusablePuzzles")'><%=i18n.common.back%></button>
</div>
