<%- include ("../partials/_header.ejs") %>

<div role="main" class="main">
    <h1>
    <%=i18n.reusablePuzzles.name%>
    </h1>
    <a  href="/reusablePuzzles/new">
        <button style="margin-bottom:1em" type="button" class="rounded addButton"><%=i18n.reusablePuzzles.create%></button>
    </a>

    <div class="rp-grid">
<% reusablePuzzles.forEach((puzzle)=>{
    let cfg = {};
    try { cfg = typeof puzzle.config === "string" ? JSON.parse(puzzle.config) : (puzzle.config || {}); } catch (e) { cfg = {}; }
    const thumb = cfg && cfg.thumbnail;
%>
        <div class="rp-card<%= puzzle.disabled ? ' disabled' : '' %>">
            <% if (thumb) { %>
                <img class="rp-thumb" src="/reusablePuzzles/<%=puzzle.id%>/<%=thumb%>" alt="<%=puzzle.name%>" onerror="this.onerror=null;this.style.display='none';"/>
            <% } else { %>
                <div class="rp-thumb-placeholder"><span class="material-icons" style="font-size:3em;">extension</span></div>
            <% } %>
            <div class="rp-body">
                <p class="rp-name"><%=puzzle.name%><% if (puzzle.disabled) { %> <span class="rp-badge">(<%=i18n.reusablePuzzles.disabled%>)</span><% } %></p>
                <div class="rp-actions">
                    <form method="POST" action="reusablePuzzles/<%=puzzle.id%>/toggleDisabled">
                        <label class="rp-switch" title="<%= puzzle.disabled ? i18n.reusablePuzzles.enable : i18n.reusablePuzzles.disable %>">
                            <input type="checkbox" onchange="this.form.submit()" <%= puzzle.disabled ? "" : "checked" %>/>
                            <span class="rp-slider"></span>
                        </label>
                    </form>
                    <span class="rp-spacer"></span>
                    <a class="rp-icon-btn" href="reusablePuzzles/<%=puzzle.id%>" title="<%=i18n.common.edit%>"><span class="material-icons">edit</span></a>
                    <form method="POST" action="reusablePuzzles/<%=puzzle.id%>?_method=DELETE" onsubmit="return confirm('<%=i18n.reusablePuzzles.deleteConfirm%>')">
                        <button class="rp-icon-btn rp-delete" type="submit" title="<%=i18n.common.delete%>"><span class="material-icons">delete</span></button>
                    </form>
                </div>
            </div>
        </div>
<%    })%>
    </div>
</div>
