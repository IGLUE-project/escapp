<%- include ("partials/_header.ejs") %>

<% const grandTotal = totals.students + totals.teachers; %>

<div role="main" class="main iglue-stats">
    <div class="dash-hero">
        <img src="https://iglue.dit.upm.es/wp-content/uploads/2024/12/iglue-logo-white.png" alt="IGLUE" class="iglue-stats-logo"/>
        <p class="dash-subtitle"><%= i18n.iglueStats.heading %></p>
    </div>

    <form method="GET" action="/iglue-stats" class="iglue-stats-filters dash-toolbar">
        <label>
            <%= i18n.iglueStats.from %>
            <input type="date" name="from" id="iglue-stats-from" value="<%= filters.from %>" <%= filters.forcePeriod ? "disabled" : "" %>/>
        </label>
        <label>
            <%= i18n.iglueStats.to %>
            <input type="date" name="to" id="iglue-stats-to" value="<%= filters.to || '2026-10-31' %>" <%= filters.forcePeriod ? "disabled" : "" %>/>
        </label>
        <label class="iglue-stats-period">
            <input type="checkbox" name="forcePeriod" id="iglue-stats-period" value="1" data-escapp2="<%= escapp2Date %>" <%= filters.forcePeriod ? "checked" : "" %>/>
            <span><%= i18n.iglueStats.sinceEscapp2 %><% if (escapp2Date) { %> (<%= new Date(escapp2Date).toLocaleDateString("es-ES", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }).replace(/\//g, "-") %> - 31-10-2026)<% } %></span>
        </label>
        <br/>
        <button type="submit" class="rounded dash-apply"><%= i18n.iglueStats.apply %></button>
        <span class="dash-downloads">
            <button type="submit" name="csv" value="1" class="rounded dash-download">
                <span class="material-icons">download</span><%= i18n.iglueStats.downloadCsv %>
            </button>
            <% if (session && session.user && session.user.isAdmin) { %>
            <button type="submit" formaction="/iglue-stats/users" class="rounded dash-download">
                <span class="material-icons">group</span><%= i18n.iglueStats.downloadUsers %>
            </button>
            <% } %>
        </span>
    </form>

    <div class="dash-kpis">
        <div class="dash-kpi kpi-students">
            <span class="kpi-icon material-icons">school</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= totals.students.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.studentsTotal %></div>
            </div>
        </div>
        <div class="dash-kpi kpi-students-registered">
            <span class="kpi-icon material-icons">school</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= totals.registeredStudents.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.studentsRegistered %></div>
            </div>
        </div>
        <div class="dash-kpi kpi-players">
            <span class="kpi-icon material-icons">sports_esports</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= totals.players.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.playersTotal %></div>
            </div>
        </div>
         <div class="dash-kpi kpi-players-registered">
            <span class="kpi-icon material-icons">sports_esports</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= totals.registeredPlayers.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.playersRegistered %></div>
            </div>
        </div>
        <div class="dash-kpi kpi-teachers">
            <span class="kpi-icon material-icons">co_present</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= totals.teachers.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.teachers %></div>
            </div>
        </div>
        <div class="dash-kpi kpi-total">
            <span class="kpi-icon material-icons">groups</span>
            <div class="kpi-body">
                <div class="kpi-num"><%= grandTotal.toLocaleString() %></div>
                <div class="kpi-label"><%= i18n.iglueStats.total %></div>
            </div>
        </div>
    </div>

    <div class="dash-panel">
        <div class="dash-panel-head">
            <h2><%= i18n.user.eduLevelField %></h2>
        </div>

        <div class="dash-levels">
            <% levels.forEach((level) => {
                const p = table[level].registeredPlayers;
                const t = table[level].teachers;
                const tot = p + t;
            %>
            <div class="lvl-card">
                <div class="lvl-name"><%= i18n.user.eduLevel[level] %></div>
                <div class="lvl-nums">
                    <div class="lvl-num players">
                        <b><%= p.toLocaleString() %></b>
                        <span><%= i18n.iglueStats.playersRegistered %></span>
                    </div>
                    <div class="lvl-num teachers">
                        <b><%= t.toLocaleString() %></b>
                        <span><%= i18n.iglueStats.teachers %></span>
                    </div>
                </div>
                <div class="lvl-total"><%= i18n.iglueStats.total %>: <%= tot.toLocaleString() %></div>
            </div>
            <% }) %>
        </div>
    </div>
</div>

<script>
    (function () {
        var forcePeriod = document.getElementById("iglue-stats-period");
        var from = document.getElementById("iglue-stats-from");
        var to = document.getElementById("iglue-stats-to");

        if (!forcePeriod || !from || !to) {
            return;
        }

        forcePeriod.addEventListener("change", function () {
            from.disabled = forcePeriod.checked;
            to.disabled = forcePeriod.checked;
            if (forcePeriod.checked) {
                if(forcePeriod.dataset.escapp2){
                    from.value = forcePeriod.dataset.escapp2;
                }
                to.value = '2026-10-31';
            }
        });
    }());
</script>
